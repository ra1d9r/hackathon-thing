# ─── Среда выполнения ────────────────────────────────────────────────────────
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Базовый URL, под которым API доступен снаружи. Попадает в openapi.json
# как адрес сервера; клиентской стороне нужен именно он.
API_BASE_URL=http://localhost:3000

# Версия сборки, отдаётся в GET /v1/version.
SERVICE_VERSION=0.1.0
GIT_SHA=

# Минимальная версия клиента; ниже неё приложение должно предложить обновление.
MIN_CLIENT_VERSION=1.0.0

# ─── Сеть и защита ───────────────────────────────────────────────────────────
# Разрешённые Origin через запятую. Мобильному клиенту CORS не нужен —
# заполняется только для запуска приложения в веб-режиме (см. docs/07-risks.md, Q-15).
CORS_ORIGINS=

REQUEST_TIMEOUT_MS=15000
BODY_LIMIT_BYTES=1048576

# Глобальный лимит запросов (см. docs/02-api.md, §6).
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW_MS=300000

# Отдельный лимит на регистрацию и заявки на учительский доступ.
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW_MS=3600000

# ─── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=

# Строка подключения к Postgres.
#
# Нужен session mode (порт 5432), а не transaction pooler (6543): в transaction
# mode не работают LISTEN/NOTIFY, на которых держатся ожидающие запросы к очереди.
#
# Прямой хост db.<ref>.supabase.co публикует только AAAA-запись, поэтому в
# IPv4-сети он недоступен. Рабочий вариант — session pooler:
#   postgresql://postgres.<ref>:<пароль>@aws-0-<регион>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Прямое подключение (IPv6). Держим для справки и для окружений с IPv6.
DATABASE_URL_DIRECT=

# Новая система ключей — используется по умолчанию.
# Отзываются по отдельности и работают в паре с асимметричной подписью токенов.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Устаревшие ключи-JWT. Запасной вариант: применяются, только если новые не заданы.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Прочие внешние сервисы ──────────────────────────────────────────────────
# Становится обязательным с фазы 5.

# ─── Провайдер модели ────────────────────────────────────────────────────────
#
# Без ключа AI-слой не поднимается, и очередь работает на детерминированных
# заменителях: тест проходится, баллы по проверяемой части выставляются,
# статистика считается. Это штатный режим, а не аварийный.
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-flash
# Пооперационно, через запятую. Дешёвую операцию — на дешёвую модель:
#   free_text_grading=deepseek-v4-flash
AI_MODEL_OVERRIDES=
AI_ENABLED=true
# json_object — режим «ответ обязан быть JSON»; схема уходит в текст промпта.
# json_schema поддерживают не все провайдеры (DeepSeek отвечает на него 400).
AI_RESPONSE_FORMAT=json_object
# У рассуждающих моделей в этот предел входят и невидимые токены рассуждения.
AI_MAX_OUTPUT_TOKENS=32768
# Сколько попыток очереди тратится на недоступность провайдера до заменителя.
AI_RETRY_BUDGET=2
AI_TIMEOUT_MS=120000
AI_MAX_CONCURRENCY=4
AI_RPM=60
AI_DAILY_QUOTA_PER_STUDENT=300
AI_BREAKER_FAILURES=5
AI_BREAKER_COOLDOWN_MS=60000

# Домены организаций, чьи заявки на учительский доступ одобряются автоматически.
# Пустой список означает, что каждую заявку рассматривает оператор вручную
# (перевод строки заявки в статус approved). См. docs/07-risks.md, R-2.
TEACHER_ORG_DOMAINS=school.kz,nis.edu.kz

# Включает воркер очереди AI в этом же процессе (см. docs/00, AD-5). С фазы 4.
WORKER_ENABLED=true
