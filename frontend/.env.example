# Скопируйте в .env и заполните.
#
# EXPO_PUBLIC_* переменные Expo встраивает в бандл на этапе сборки — они
# видны клиенту, поэтому здесь только публичные значения (anon key Supabase
# защищён политиками RLS на стороне базы, а не секретностью самого ключа).

# Адрес backend API.
#   - Android-эмулятор:        http://10.0.2.2:3000
#   - iOS-симулятор:           http://localhost:3000
#   - физическое устройство:   http://<LAN-адрес компьютера>:3000  (напр. http://192.168.1.50:3000)
#   - собранный APK/релиз:     публичный адрес развёрнутого backend (обязателен — localhost недостижим)
#
# Внимание: этот файл в .gitignore, поэтому в сборку EAS он НЕ попадает.
# Значения для APK берутся из блока "env" в eas.json (build.preview / build.production)
# — правьте их там, иначе клиент соберётся с пустым Supabase и localhost вместо API.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Те же значения, что в backend/.env (SUPABASE_URL, SUPABASE_ANON_KEY) —
# вход идёт напрямую через Supabase Auth, backend токены не выдаёт.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
